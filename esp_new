--[[
    LightESP - Fixed Version
    - Fix skeleton nil error
    - Fix ESP duplication / ghost players
    - Smooth skeleton
    - Weapon text putih
    - HP gradient
    - Chams highlight
]]

local LightESP = {}
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local plr = Players.LocalPlayer
local Camera = workspace.CurrentCamera

if getgenv().__LightESP_LOADED then 
    -- Jika sudah loaded, unload dulu biar ga double
    pcall(getgenv().__LightESP_LOADED.Unload)
    getgenv().__LightESP_LOADED = nil
end

-- Konfigurasi default
local Config = {
    Enabled = true,
    Keybind = { Enabled = true, Key = Enum.KeyCode.Insert },
    Players = true,
    LocalPlayer = false,
    LimitFPS = 0,
    Boxes = true,
    BoxType = "Corner",
    BoxColor = Color3.fromRGB(255,255,255),
    BoxThickness = 1,
    HealthBar = {
        Enabled = true,
        Position = "Left",
        Width = 2,
        ShowText = true,
        HideWhenFullHP = true,
    },
    Names = true,
    TextSize = 11,
    TextColor = Color3.fromRGB(255,255,255),
    TextOutline = true,
    Distance = { Enabled = true, Unit = "Meters", StudsPerMeter = 3, Ending = "m", Gap = 2 },
    Weapon = { Enabled = true, Gap = 1, Color = Color3.fromRGB(255,255,255) },
    Skeleton = { Enabled = false, Color = Color3.fromRGB(255,255,255), Thickness = 1, Smoothing = 0.3 },
    CookingIndicator = false,
    Chams = { Enabled = false, Highlight = { FillColor = Color3.fromRGB(59,144,204), FillTransparency = 0.6, OutlineColor = Color3.fromRGB(255,255,255), OutlineTransparency = 0, VisibleCheck = false } },
    MaxDistance = 500,
    Tracer = false,
}

local espObjs = {}      -- [player] = obj
local cache = {}
local connections = {}
local renderConn = nil
local lastRender = 0
local lastScan = 0
local ChamsContainer = nil

local function GetHealthColor(percent)
    if percent >= 0.5 then
        local t = (percent - 0.5) * 2
        return Color3.fromRGB(math.floor(255 * (1 - t)), 255, 0)
    else
        local t = percent * 2
        return Color3.fromRGB(255, math.floor(255 * t), 0)
    end
end

local COOKING_KW = {"water","sugar","gelatin","marshmallow","empty bag"}
local function isCooking(name)
    local n = name:lower()
    for _, kw in ipairs(COOKING_KW) do if n:find(kw) then return true end end
    return false
end

local function rebuildCache(p)
    if not p or not p.Parent then return end
    local hasCooking = false
    local weaponName = nil
    pcall(function()
        if p.Backpack then
            for _, v in pairs(p.Backpack:GetChildren()) do
                if v:IsA("Tool") and isCooking(v.Name) then hasCooking = true end
            end
        end
        local ch = p.Character
        if ch then
            for _, v in pairs(ch:GetChildren()) do
                if v:IsA("Tool") then
                    if isCooking(v.Name) then hasCooking = true else weaponName = v.Name end
                end
            end
        end
    end)
    cache[p] = { hasCooking = hasCooking, weaponName = weaponName }
end

local function setupChams(character)
    if not Config.Chams.Enabled then return nil end
    if not ChamsContainer then
        ChamsContainer = Instance.new("Folder")
        ChamsContainer.Name = "LightESP_Chams"
        ChamsContainer.Parent = gethui and gethui() or game:GetService("CoreGui")
    end
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Parent = ChamsContainer
    highlight.Adornee = character
    highlight.FillColor = Config.Chams.Highlight.FillColor
    highlight.FillTransparency = Config.Chams.Highlight.FillTransparency
    highlight.OutlineColor = Config.Chams.Highlight.OutlineColor
    highlight.OutlineTransparency = Config.Chams.Highlight.OutlineTransparency
    highlight.DepthMode = Config.Chams.Highlight.VisibleCheck and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = true
    return highlight
end

local function connectPlayer(p)
    if p == plr or connections[p] then return end
    local conns = {}
    rebuildCache(p)
    local bp = p.Backpack
    if bp then
        table.insert(conns, bp.ChildAdded:Connect(function() rebuildCache(p) end))
        table.insert(conns, bp.ChildRemoved:Connect(function() rebuildCache(p) end))
    end
    local function watchChar(ch)
        if not ch then return end
        table.insert(conns, ch.ChildAdded:Connect(function(v) if v:IsA("Tool") then rebuildCache(p) end end))
        table.insert(conns, ch.ChildRemoved:Connect(function(v) if v:IsA("Tool") then rebuildCache(p) end end))
        rebuildCache(p)
        if espObjs[p] and Config.Chams.Enabled then
            if espObjs[p].Highlight then espObjs[p].Highlight:Destroy() end
            espObjs[p].Highlight = setupChams(ch)
        end
    end
    if p.Character then watchChar(p.Character) end
    table.insert(conns, p.CharacterAdded:Connect(watchChar))
    connections[p] = conns
end

local function disconnectPlayer(p)
    if connections[p] then
        for _, c in ipairs(connections[p]) do pcall(c.Disconnect) end
        connections[p] = nil
    end
    cache[p] = nil
end

local function getStableBox(character, hum, rootPart)
    if not character or not hum or not rootPart then return nil, nil end
    local isR6 = hum.RigType == Enum.HumanoidRigType.R6
    local topOffset = isR6 and 2.8 or 3.0
    local bottomOffset = isR6 and 3.0 or 3.5
    local topPos = rootPart.Position + Vector3.new(0, topOffset, 0)
    local bottomPos = rootPart.Position - Vector3.new(0, bottomOffset, 0)
    local top2D = Camera:WorldToViewportPoint(topPos)
    local bottom2D = Camera:WorldToViewportPoint(bottomPos)
    local height = math.abs(top2D.Y - bottom2D.Y)
    local centerX = (top2D.X + bottom2D.X) / 2
    local centerY = (top2D.Y + bottom2D.Y) / 2
    return Vector2.new(centerX, centerY), Vector2.new(height * 0.65, height)
end

local function createESPObj(p)
    local obj = {
        box = Drawing.new("Square"),
        corners = {},
        tracer = Drawing.new("Line"),
        nameText = Drawing.new("Text"),
        distText = Drawing.new("Text"),
        hpBg = Drawing.new("Square"),
        hpFill = Drawing.new("Square"),
        hpNum = Drawing.new("Text"),
        weaponText = Drawing.new("Text"),
        cookingText = Drawing.new("Text"),
        skeleton = {},
        skeletonLastPos = {},
        lastPos = nil,
        lastSize = nil,
        Highlight = nil,
    }
    obj.box.Thickness = Config.BoxThickness
    obj.box.Filled = false
    obj.box.Visible = false
    obj.tracer.Thickness = 1.2
    obj.tracer.Visible = false
    for _, t in ipairs({obj.nameText, obj.distText, obj.hpNum, obj.weaponText, obj.cookingText}) do
        t.Size = Config.TextSize
        t.Color = Config.TextColor
        t.Outline = Config.TextOutline
        t.OutlineColor = Color3.fromRGB(0,0,0)
        t.Center = true
        t.Font = Drawing.Fonts.Plex
        t.Visible = false
    end
    obj.weaponText.Color = Config.Weapon.Color
    obj.hpBg.Thickness = 1
    obj.hpBg.Filled = true
    obj.hpBg.Color = Color3.fromRGB(20,20,20)
    obj.hpBg.Visible = false
    obj.hpFill.Thickness = 0
    obj.hpFill.Filled = true
    obj.hpFill.Visible = false
    obj.hpNum.Size = 9
    obj.hpNum.Visible = false
    for i = 1, 8 do
        local line = Drawing.new("Line")
        line.Thickness = Config.BoxThickness
        line.Color = Config.BoxColor
        line.Visible = false
        table.insert(obj.corners, line)
    end
    -- Skeleton 14 lines, pastikan semua non-nil
    for i = 1, 14 do
        local line = Drawing.new("Line")
        line.Thickness = Config.Skeleton.Thickness
        line.Color = Config.Skeleton.Color
        line.Visible = false
        table.insert(obj.skeleton, line)
    end
    return obj
end

local function hideESP(obj)
    if not obj then return end
    obj.box.Visible = false
    obj.tracer.Visible = false
    obj.nameText.Visible = false
    obj.distText.Visible = false
    obj.hpBg.Visible = false
    obj.hpFill.Visible = false
    obj.hpNum.Visible = false
    obj.weaponText.Visible = false
    obj.cookingText.Visible = false
    for _, l in ipairs(obj.corners) do if l then l.Visible = false end end
    for _, l in ipairs(obj.skeleton) do if l then l.Visible = false end end
end

local function removeESP(p)
    local obj = espObjs[p]
    if obj then
        if obj.Highlight then pcall(obj.Highlight.Destroy, obj.Highlight) end
        pcall(function()
            obj.box:Remove()
            obj.tracer:Remove()
            obj.nameText:Remove()
            obj.distText:Remove()
            obj.hpBg:Remove()
            obj.hpFill:Remove()
            obj.hpNum:Remove()
            obj.weaponText:Remove()
            obj.cookingText:Remove()
            for _, l in ipairs(obj.corners) do l:Remove() end
            for _, l in ipairs(obj.skeleton) do l:Remove() end
        end)
        espObjs[p] = nil
    end
    disconnectPlayer(p)
end

local SKEL_BONES = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
    {"RightUpperLeg","LeftUpperLeg"},
}

local function updateSkeleton(ch, obj, cam)
    if not obj or not obj.skeleton then return end
    local smooth = Config.Skeleton.Smoothing or 0.3
    for i, bones in ipairs(SKEL_BONES) do
        local line = obj.skeleton[i]
        if not line then continue end  -- Guard biar ga error nil
        local p1 = ch:FindFirstChild(bones[1])
        local p2 = ch:FindFirstChild(bones[2])
        if p1 and p2 then
            local v1, o1 = cam:WorldToViewportPoint(p1.Position)
            local v2, o2 = cam:WorldToViewportPoint(p2.Position)
            if o1 and o2 and v1.Z > 0 and v2.Z > 0 then
                local newFrom = Vector2.new(v1.X, v1.Y)
                local newTo = Vector2.new(v2.X, v2.Y)
                if obj.skeletonLastPos[i] then
                    newFrom = newFrom:Lerp(obj.skeletonLastPos[i].from, smooth)
                    newTo = newTo:Lerp(obj.skeletonLastPos[i].to, smooth)
                end
                line.From = newFrom
                line.To = newTo
                line.Visible = true
                obj.skeletonLastPos[i] = { from = newFrom, to = newTo }
            else
                line.Visible = false
                obj.skeletonLastPos[i] = nil
            end
        else
            line.Visible = false
            obj.skeletonLastPos[i] = nil
        end
    end
end

local function renderStep()
    if not Config.Enabled then
        for _, obj in pairs(espObjs) do 
            if obj then hideESP(obj) end
            if obj and obj.Highlight then obj.Highlight.Enabled = false end
        end
        return
    end

    local now = tick()
    if Config.LimitFPS > 0 and (now - lastRender) < (1/Config.LimitFPS) then return end
    lastRender = now

    if now - lastScan > 1 then
        lastScan = now
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= plr and not espObjs[p] then
                espObjs[p] = createESPObj(p)
                connectPlayer(p)
            end
        end
        -- Cleanup players yang sudah tidak ada
        for p, _ in pairs(espObjs) do
            if not p or not p.Parent then
                removeESP(p)
            end
        end
    end

    local cam = Camera
    local vp = cam.ViewportSize
    local localChar = plr.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for p, obj in pairs(espObjs) do
        if not obj then continue end
        local ch = p.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = ch and ch:FindFirstChild("HumanoidRootPart")

        if not ch or not hum or not root or hum.Health <= 0 then
            hideESP(obj)
            if obj.Highlight then obj.Highlight.Enabled = false end
            continue
        end

        if localRoot and (root.Position - localRoot.Position).Magnitude > Config.MaxDistance then
            hideESP(obj)
            if obj.Highlight then obj.Highlight.Enabled = false end
            continue
        end

        -- Update chams
        if Config.Chams.Enabled then
            if not obj.Highlight or not obj.Highlight.Parent then
                if obj.Highlight then pcall(obj.Highlight.Destroy, obj.Highlight) end
                obj.Highlight = setupChams(ch)
            elseif obj.Highlight.Adornee ~= ch then
                obj.Highlight.Adornee = ch
            end
            if obj.Highlight then
                obj.Highlight.FillColor = Config.Chams.Highlight.FillColor
                obj.Highlight.FillTransparency = Config.Chams.Highlight.FillTransparency
                obj.Highlight.OutlineColor = Config.Chams.Highlight.OutlineColor
                obj.Highlight.OutlineTransparency = Config.Chams.Highlight.OutlineTransparency
                obj.Highlight.Enabled = true
            end
        else
            if obj.Highlight then obj.Highlight.Enabled = false end
        end

        local pos2d, size2d = getStableBox(ch, hum, root)
        if not pos2d or not size2d then
            hideESP(obj)
            continue
        end

        if obj.lastPos and obj.lastSize then
            pos2d = pos2d:Lerp(obj.lastPos, 0.3)
            size2d = size2d:Lerp(obj.lastSize, 0.3)
        end
        obj.lastPos = pos2d
        obj.lastSize = size2d

        local boxX = pos2d.X - size2d.X/2
        local boxY = pos2d.Y - size2d.Y/2
        local boxW = size2d.X
        local boxH = size2d.Y

        -- Box
        if Config.Boxes then
            if Config.BoxType == "Normal" then
                obj.box.Size = Vector2.new(boxW, boxH)
                obj.box.Position = Vector2.new(boxX, boxY)
                obj.box.Color = Config.BoxColor
                obj.box.Visible = true
                for _, l in ipairs(obj.corners) do if l then l.Visible = false end end
            else
                obj.box.Visible = false
                local len = math.min(boxW, boxH) * 0.25
                local corners = obj.corners
                if corners[1] then corners[1].From = Vector2.new(boxX, boxY); corners[1].To = Vector2.new(boxX+len, boxY) end
                if corners[2] then corners[2].From = Vector2.new(boxX, boxY); corners[2].To = Vector2.new(boxX, boxY+len) end
                if corners[3] then corners[3].From = Vector2.new(boxX+boxW, boxY); corners[3].To = Vector2.new(boxX+boxW-len, boxY) end
                if corners[4] then corners[4].From = Vector2.new(boxX+boxW, boxY); corners[4].To = Vector2.new(boxX+boxW, boxY+len) end
                if corners[5] then corners[5].From = Vector2.new(boxX, boxY+boxH); corners[5].To = Vector2.new(boxX+len, boxY+boxH) end
                if corners[6] then corners[6].From = Vector2.new(boxX, boxY+boxH); corners[6].To = Vector2.new(boxX, boxY+boxH-len) end
                if corners[7] then corners[7].From = Vector2.new(boxX+boxW, boxY+boxH); corners[7].To = Vector2.new(boxX+boxW-len, boxY+boxH) end
                if corners[8] then corners[8].From = Vector2.new(boxX+boxW, boxY+boxH); corners[8].To = Vector2.new(boxX+boxW, boxY+boxH-len) end
                for _, l in ipairs(corners) do if l then l.Visible = true; l.Color = Config.BoxColor end end
            end
        else
            obj.box.Visible = false
            for _, l in ipairs(obj.corners) do if l then l.Visible = false end end
        end

        -- Tracer
        if Config.Tracer then
            obj.tracer.From = Vector2.new(vp.X/2, vp.Y)
            obj.tracer.To = Vector2.new(pos2d.X, boxY+boxH)
            obj.tracer.Visible = true
        else
            obj.tracer.Visible = false
        end

        -- Name
        if Config.Names then
            obj.nameText.Text = p.DisplayName or p.Name
            obj.nameText.Size = Config.TextSize
            obj.nameText.Color = Config.TextColor
            obj.nameText.Position = Vector2.new(pos2d.X, boxY - 14)
            obj.nameText.Visible = true
        else
            obj.nameText.Visible = false
        end

        -- Distance
        if Config.Distance.Enabled and localRoot then
            local dist = math.floor((root.Position - localRoot.Position).Magnitude)
            if Config.Distance.Unit == "Meters" then
                dist = math.floor(dist / Config.Distance.StudsPerMeter)
            end
            obj.distText.Text = dist .. Config.Distance.Ending
            obj.distText.Size = Config.TextSize
            obj.distText.Color = Config.TextColor
            obj.distText.Position = Vector2.new(pos2d.X, boxY + boxH + Config.Distance.Gap)
            obj.distText.Visible = true
        else
            obj.distText.Visible = false
        end

        -- Health Bar
        if Config.HealthBar.Enabled then
            local hpPercent = hum.Health / hum.MaxHealth
            local barX = boxX - 6
            if Config.HealthBar.Position == "Right" then barX = boxX + boxW + 2 end
            obj.hpBg.Size = Vector2.new(Config.HealthBar.Width, boxH)
            obj.hpBg.Position = Vector2.new(barX, boxY)
            obj.hpBg.Visible = true
            local fillH = boxH * hpPercent
            obj.hpFill.Size = Vector2.new(Config.HealthBar.Width, fillH)
            obj.hpFill.Position = Vector2.new(barX, boxY + boxH - fillH)
            obj.hpFill.Color = GetHealthColor(hpPercent)
            obj.hpFill.Visible = true
            if Config.HealthBar.ShowText and (not Config.HealthBar.HideWhenFullHP or hpPercent < 1) then
                obj.hpNum.Text = math.floor(hum.Health) .. " HP"
                obj.hpNum.Color = GetHealthColor(hpPercent)
                obj.hpNum.Position = Vector2.new(barX + Config.HealthBar.Width/2, boxY - 8)
                obj.hpNum.Visible = true
            else
                obj.hpNum.Visible = false
            end
        else
            obj.hpBg.Visible = false
            obj.hpFill.Visible = false
            obj.hpNum.Visible = false
        end

        -- Weapon
        if Config.Weapon.Enabled then
            local wep = cache[p] and cache[p].weaponName
            if wep then
                obj.weaponText.Text = wep
                obj.weaponText.Size = Config.TextSize
                obj.weaponText.Color = Config.Weapon.Color
                obj.weaponText.Position = Vector2.new(pos2d.X, boxY + boxH + Config.Distance.Gap + 12)
                obj.weaponText.Visible = true
            else
                obj.weaponText.Visible = false
            end
        else
            obj.weaponText.Visible = false
        end

        -- Cooking indicator
        if Config.CookingIndicator and cache[p] and cache[p].hasCooking then
            obj.cookingText.Text = "🍳 MASAK"
            obj.cookingText.Size = Config.TextSize
            obj.cookingText.Color = Color3.fromRGB(0,255,100)
            obj.cookingText.Position = Vector2.new(boxX + boxW + 5, boxY + boxH/2 - 8)
            obj.cookingText.Center = false
            obj.cookingText.Visible = true
        else
            obj.cookingText.Visible = false
        end

        -- Skeleton
        if Config.Skeleton.Enabled then
            updateSkeleton(ch, obj, cam)
        else
            for _, l in ipairs(obj.skeleton) do if l then l.Visible = false end end
            for i = 1, 14 do obj.skeletonLastPos[i] = nil end
        end
    end
end

function LightESP:Load(customConfig)
    self:Unload()
    if customConfig then
        for k, v in pairs(customConfig) do Config[k] = v end
    end
    renderConn = RunService.RenderStepped:Connect(renderStep)
    if Config.Keybind.Enabled then
        UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == Config.Keybind.Key then
                Config.Enabled = not Config.Enabled
            end
        end)
    end
    return self
end

function LightESP:Unload()
    if renderConn then renderConn:Disconnect(); renderConn = nil end
    for p, _ in pairs(espObjs) do removeESP(p) end
    espObjs = {}
    cache = {}
    for p, _ in pairs(connections) do disconnectPlayer(p) end
    connections = {}
    if ChamsContainer then ChamsContainer:Destroy(); ChamsContainer = nil end
end

function LightESP:GetConfig()
    return Config
end

function LightESP:UpdateConfig(new)
    for k, v in pairs(new) do Config[k] = v end
    for p, obj in pairs(espObjs) do
        if obj.weaponText then obj.weaponText.Color = Config.Weapon.Color end
        if obj.skeleton then
            for _, line in ipairs(obj.skeleton) do
                if line then line.Thickness = Config.Skeleton.Thickness; line.Color = Config.Skeleton.Color end
            end
        end
    end
end

function LightESP:SetEnabled(enabled)
    Config.Enabled = enabled
end

getgenv().__LightESP_LOADED = LightESP
return LightESP
