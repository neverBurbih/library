local function hideESP(obj)
    if not obj then return end
    obj.box.Visible = false
    obj.tracer.Visible = false
    obj.nameText.Visible = false
    obj.distText.Visible = false
    obj.hpBg.Visible = false
    obj.hpFill.Visible = false
    obj.hpNum.Visible = false
    obj.weaponText.Visible = false
    obj.cookingText.Visible = false
    for _, l in ipairs(obj.corners) do l.Visible = false end
    for _, l in ipairs(obj.skeleton) do l.Visible = false end
end

local function removeESP(p)
    local obj = espObjs[p]
    if obj then
        pcall(function()
            obj.box:Remove()
            obj.tracer:Remove()
            obj.nameText:Remove()
            obj.distText:Remove()
            obj.hpBg:Remove()
            obj.hpFill:Remove()
            obj.hpNum:Remove()
            obj.weaponText:Remove()
            obj.cookingText:Remove()
            for _, l in ipairs(obj.corners) do l:Remove() end
            for _, l in ipairs(obj.skeleton) do l:Remove() end
            -- Chams cleanup
            if obj.highlight then obj.highlight:Destroy() end
            for _, a in ipairs(obj.adornments) do a:Destroy() end
            if obj.meshShell then obj.meshShell:Destroy() end
        end)
        espObjs[p] = nil
    end
    disconnectPlayer(p)
end

-- Chams update function
local function updateChams(instance, obj, isDead)
    local chamsEnabled = Config.Chams.Enabled
    if not chamsEnabled or isDead then
        -- Hapus semua chams
        if obj.highlight then obj.highlight:Destroy(); obj.highlight = nil end
        for _, a in ipairs(obj.adornments) do a:Destroy() end
        obj.adornments = {}
        if obj.meshShell then obj.meshShell:Destroy(); obj.meshShell = nil; obj.meshHighlight = nil end
        return
    end

    local chamType = Config.Chams.Type
    EnsureRootInstances()

    if chamType == "Highlight" then
        -- Bersihkan yang lain
        for _, a in ipairs(obj.adornments) do a:Destroy() end
        obj.adornments = {}
        if obj.meshShell then obj.meshShell:Destroy(); obj.meshShell = nil; obj.meshHighlight = nil end
        
        if not obj.highlight then
            obj.highlight = Instance.new("Highlight")
            obj.highlight.Name = "LightESP_Highlight"
            obj.highlight.Parent = ChamsContainer
        end
        local h = obj.highlight
        h.Adornee = instance
        h.FillColor = Config.Chams.Highlight.FillColor
        h.FillTransparency = Config.Chams.Highlight.FillTransparency
        h.OutlineColor = Config.Chams.Highlight.OutlineColor
        h.OutlineTransparency = Config.Chams.Highlight.OutlineTransparency
        h.DepthMode = Config.Chams.Highlight.VisibleCheck and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
        h.Enabled = true
    elseif chamType == "Adornment" then
        if obj.highlight then obj.highlight:Destroy(); obj.highlight = nil end
        if obj.meshShell then obj.meshShell:Destroy(); obj.meshShell = nil; obj.meshHighlight = nil end
        
        local parts = instance:IsA("Model") and instance:GetChildren() or {instance}
        local idx = 0
        for _, part in ipairs(parts) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                idx = idx + 1
                local a = obj.adornments[idx]
                if not a then
                    a = Instance.new("BoxHandleAdornment")
                    a.Name = "LightESP_Adornment"
                    a.Parent = ChamsContainer
                    obj.adornments[idx] = a
                end
                a.Adornee = part
                a.Size = part.Size
                a.Color3 = Config.Chams.Adornment.Color
                a.Transparency = Config.Chams.Adornment.Transparency
                a.AlwaysOnTop = Config.Chams.Adornment.AlwaysOnTop
                a.ZIndex = 10
                a.Visible = true
            end
        end
        for i = idx+1, #obj.adornments do
            obj.adornments[i]:Destroy()
        end
        obj.adornments = {unpack(obj.adornments, 1, idx)}
    elseif chamType == "MeshChams" then
        if obj.highlight then obj.highlight:Destroy(); obj.highlight = nil end
        for _, a in ipairs(obj.adornments) do a:Destroy() end
        obj.adornments = {}
        
        local playerOwner = Players:GetPlayerFromCharacter(instance)
        if not playerOwner then
            if obj.meshShell then obj.meshShell:Destroy(); obj.meshShell = nil; obj.meshHighlight = nil end
            return
        end
        
        if not obj.meshShell or not obj.meshShell.Parent then
            if obj.meshShell then obj.meshShell:Destroy() end
            CleanupCharacterMeshChams(instance)
            
            local r6Parts = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
            local r15Parts = {
                "Head", "UpperTorso", "LowerTorso",
                "LeftUpperArm", "LeftLowerArm", "LeftHand",
                "RightUpperArm", "RightLowerArm", "RightHand",
                "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
                "RightUpperLeg", "RightLowerLeg", "RightFoot",
            }
            local hum = instance:FindFirstChild("Humanoid")
            local isR15 = hum and hum.RigType == Enum.HumanoidRigType.R15
            local bodyParts = isR15 and r15Parts or r6Parts
            
            local shellModel = Instance.new("Model")
            shellModel.Name = "ChamShells"
            shellModel:SetAttribute("LightESP_MeshCham", true)
            shellModel:SetAttribute("LightESP_RunId", CurrentRunId)
            shellModel.Parent = MeshChamsFolder
            
            for _, partName in ipairs(bodyParts) do
                local realPart = instance:FindFirstChild(partName)
                if realPart and realPart:IsA("BasePart") then
                    local shell = Instance.new("Part")
                    shell.Name = "ChamShell_" .. partName
                    shell:SetAttribute("LightESP_MeshCham", true)
                    shell.Size = realPart.Size * 1.015
                    shell.Transparency = 0.9999999
                    shell.CastShadow = false
                    shell.CanCollide = false
                    shell.CanQuery = false
                    shell.CanTouch = false
                    shell.Anchored = false
                    shell.Massless = true
                    shell.CFrame = realPart.CFrame
                    shell.Parent = shellModel
                    
                    local weld = Instance.new("Weld")
                    weld.Part0 = shell
                    weld.Part1 = realPart
                    weld.C0 = CFrame.new()
                    weld.C1 = CFrame.new()
                    weld.Parent = shell
                end
            end
            
            local hl = Instance.new("Highlight")
            hl.Name = "ChamShellHighlight"
            hl:SetAttribute("LightESP_MeshCham", true)
            hl.Adornee = shellModel
            hl.Parent = shellModel
            obj.meshShell = shellModel
            obj.meshHighlight = hl
        end
        
        if obj.meshHighlight then
            obj.meshHighlight.FillColor = Config.Chams.MeshChams.FillColor
            obj.meshHighlight.FillTransparency = Config.Chams.MeshChams.FillTransparency
            obj.meshHighlight.OutlineColor = Config.Chams.MeshChams.OutlineColor
            obj.meshHighlight.OutlineTransparency = Config.Chams.MeshChams.OutlineTransparency
            obj.meshHighlight.DepthMode = Config.Chams.MeshChams.VisibleCheck and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
            obj.meshHighlight.Enabled = true
        end
    end
end

local SKEL_BONES = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
    {"RightUpperLeg","LeftUpperLeg"},
}

local function updateSkeleton(ch, obj, cam)
    local smoothFactor = Config.Skeleton.Smoothing or 0.3
    for i, bones in ipairs(SKEL_BONES) do
        local p1 = ch:FindFirstChild(bones[1])
        local p2 = ch:FindFirstChild(bones[2])
        local line = obj.skeleton[i]
        if p1 and p2 then
            local v1, o1 = cam:WorldToViewportPoint(p1.Position)
            local v2, o2 = cam:WorldToViewportPoint(p2.Position)
            if o1 and o2 and v1.Z > 0 and v2.Z > 0 then
                local newFrom = Vector2.new(v1.X, v1.Y)
                local newTo = Vector2.new(v2.X, v2.Y)
                if obj.skeletonLastPos[i] then
                    local lastFrom, lastTo = obj.skeletonLastPos[i].from, obj.skeletonLastPos[i].to
                    newFrom = newFrom:Lerp(lastFrom, smoothFactor)
                    newTo = newTo:Lerp(lastTo, smoothFactor)
                end
                line.From = newFrom
                line.To = newTo
                line.Visible = true
                obj.skeletonLastPos[i] = { from = newFrom, to = newTo }
            else
                line.Visible = false
                obj.skeletonLastPos[i] = nil
            end
        else
            line.Visible = false
            obj.skeletonLastPos[i] = nil
        end
    end
end

local function renderStep()
    if not Config.Enabled then
        for p, obj in pairs(espObjs) do hideESP(obj) end
        return
    end

    local now = tick()
    if Config.LimitFPS > 0 and (now - lastRender) < (1/Config.LimitFPS) then return end
    lastRender = now

    if now - lastScan > 1 then
        lastScan = now
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= plr and not espObjs[p] then
                espObjs[p] = createESPObj(p)
                connectPlayer(p)
            end
        end
    end

    local cam = Camera
    local vp = cam.ViewportSize
    local localChar = plr.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for p, obj in pairs(espObjs) do
        local ch = p.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        local isDead = not hum or hum.Health <= 0

        if not ch or not hum or not root or isDead then
            hideESP(obj)
            updateChams(ch, obj, true)
            continue
        end

        if localRoot and (root.Position - localRoot.Position).Magnitude > Config.MaxDistance then
            hideESP(obj)
            updateChams(ch, obj, false) -- tetap update chams walau jauh? lebih baik matikan
            continue
        end

        -- Update Chams
        updateChams(ch, obj, false)

        local pos2d, size2d = getStableBox(ch, hum, root)
        if not pos2d or not size2d then
            hideESP(obj)
            continue
        end

        -- Smoothing box
        if obj.lastPos and obj.lastSize then
            pos2d = pos2d:Lerp(obj.lastPos, 0.3)
            size2d = size2d:Lerp(obj.lastSize, 0.3)
        end
        obj.lastPos = pos2d
        obj.lastSize = size2d

        local boxX = pos2d.X - size2d.X/2
        local boxY = pos2d.Y - size2d.Y/2
        local boxW = size2d.X
        local boxH = size2d.Y

        -- Box
        if Config.Boxes then
            if Config.BoxType == "Normal" then
                obj.box.Size = Vector2.new(boxW, boxH)
                obj.box.Position = Vector2.new(boxX, boxY)
                obj.box.Color = Config.BoxColor
                obj.box.Visible = true
                for _, l in ipairs(obj.corners) do l.Visible = false end
            else
                obj.box.Visible = false
                local len = math.min(boxW, boxH) * 0.25
                local corners = obj.corners
                corners[1].From = Vector2.new(boxX, boxY)
                corners[1].To = Vector2.new(boxX+len, boxY)
                corners[2].From = Vector2.new(boxX, boxY)
                corners[2].To = Vector2.new(boxX, boxY+len)
                corners[3].From = Vector2.new(boxX+boxW, boxY)
                corners[3].To = Vector2.new(boxX+boxW-len, boxY)
                corners[4].From = Vector2.new(boxX+boxW, boxY)
                corners[4].To = Vector2.new(boxX+boxW, boxY+len)
                corners[5].From = Vector2.new(boxX, boxY+boxH)
                corners[5].To = Vector2.new(boxX+len, boxY+boxH)
                corners[6].From = Vector2.new(boxX, boxY+boxH)
                corners[6].To = Vector2.new(boxX, boxY+boxH-len)
                corners[7].From = Vector2.new(boxX+boxW, boxY+boxH)
                corners[7].To = Vector2.new(boxX+boxW-len, boxY+boxH)
                corners[8].From = Vector2.new(boxX+boxW, boxY+boxH)
                corners[8].To = Vector2.new(boxX+boxW, boxY+boxH-len)
                for _, l in ipairs(corners) do
                    l.Color = Config.BoxColor
                    l.Visible = true
                end
            end
        else
            obj.box.Visible = false
            for _, l in ipairs(obj.corners) do l.Visible = false end
        end

        -- Tracer
        if Config.Tracer then
            obj.tracer.From = Vector2.new(vp.X/2, vp.Y)
            obj.tracer.To = Vector2.new(pos2d.X, boxY+boxH)
            obj.tracer.Visible = true
        else
            obj.tracer.Visible = false
        end

        -- Name
        if Config.Names then
            obj.nameText.Text = p.DisplayName or p.Name
            obj.nameText.Size = Config.TextSize
            obj.nameText.Color = Config.TextColor
            obj.nameText.Position = Vector2.new(pos2d.X, boxY - 14)
            obj.nameText.Visible = true
        else
            obj.nameText.Visible = false
        end

        -- Distance
        if Config.Distance.Enabled and localRoot then
            local dist = math.floor((root.Position - localRoot.Position).Magnitude)
            if Config.Distance.Unit == "Meters" then
                dist = math.floor(dist / Config.Distance.StudsPerMeter)
            end
            obj.distText.Text = dist .. Config.Distance.Ending
            obj.distText.Size = Config.TextSize
            obj.distText.Color = Config.TextColor
            obj.distText.Position = Vector2.new(pos2d.X, boxY + boxH + Config.Distance.Gap)
            obj.distText.Visible = true
        else
            obj.distText.Visible = false
        end

        -- Health Bar
        if Config.HealthBar.Enabled then
            local hpPercent = hum.Health / hum.MaxHealth
            local barX = boxX - 6
            if Config.HealthBar.Position == "Right" then barX = boxX + boxW + 2 end
            local barWidth = Config.HealthBar.Width

            obj.hpBg.Size = Vector2.new(barWidth, boxH)
            obj.hpBg.Position = Vector2.new(barX, boxY)
            obj.hpBg.Visible = true

            local fillH = boxH * hpPercent
            obj.hpFill.Size = Vector2.new(barWidth, fillH)
            obj.hpFill.Position = Vector2.new(barX, boxY + boxH - fillH)
            if Config.HealthBar.Gradient.Enabled then
                obj.hpFill.Color = GetHealthColor(hpPercent)
            else
                obj.hpFill.Color = Color3.fromRGB(0,255,0)
            end
            obj.hpFill.Visible = true

            if Config.HealthBar.ShowText and (not Config.HealthBar.HideWhenFullHP or hpPercent < 1) then
                obj.hpNum.Text = math.floor(hum.Health) .. " HP"
                if Config.HealthBar.Gradient.Enabled then
                    obj.hpNum.Color = GetHealthColor(hpPercent)
                else
                    obj.hpNum.Color = Color3.fromRGB(255,255,255)
                end
                obj.hpNum.Position = Vector2.new(barX + barWidth/2, boxY - 8)
                obj.hpNum.Visible = true
            else
                obj.hpNum.Visible = false
            end
        else
            obj.hpBg.Visible = false
            obj.hpFill.Visible = false
            obj.hpNum.Visible = false
        end

        -- Weapon (warna putih)
        if Config.Weapon.Enabled then
            local wep = cache[p] and cache[p].weaponName
            if wep then
                obj.weaponText.Text = wep
                obj.weaponText.Size = Config.TextSize
                obj.weaponText.Color = Config.Weapon.Color or Color3.fromRGB(255,255,255)
                obj.weaponText.Position = Vector2.new(pos2d.X, boxY + boxH + Config.Distance.Gap + 12)
                obj.weaponText.Visible = true
            else
                obj.weaponText.Visible = false
            end
        else
            obj.weaponText.Visible = false
        end

        -- Cooking indicator
        if Config.CookingIndicator and cache[p] and cache[p].hasCooking then
            obj.cookingText.Text = "🍳 MASAK"
            obj.cookingText.Size = Config.TextSize
            obj.cookingText.Color = Color3.fromRGB(0,255,100)
            obj.cookingText.Position = Vector2.new(boxX + boxW + 5, boxY + boxH/2 - 8)
            obj.cookingText.Center = false
            obj.cookingText.Visible = true
        else
            obj.cookingText.Visible = false
        end

        -- Skeleton
        if Config.Skeleton.Enabled then
            updateSkeleton(ch, obj, cam)
        else
            for _, l in ipairs(obj.skeleton) do l.Visible = false end
            for i = 1, 14 do obj.skeletonLastPos[i] = nil end
        end
    end
end

-- Public API
function LightESP:Load(customConfig)
    self:Unload()
    if customConfig then
        for k, v in pairs(customConfig) do Config[k] = v end
    end
    EnsureRootInstances()
    CurrentRunId = HttpService:GenerateGUID(false)
    renderConn = RunService.RenderStepped:Connect(renderStep)
    if Config.Keybind.Enabled then
        UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == Config.Keybind.Key then
                Config.Enabled = not Config.Enabled
            end
        end)
    end
    return self
end

function LightESP:Unload()
    if renderConn then renderConn:Disconnect(); renderConn = nil end
    for p, _ in pairs(espObjs) do removeESP(p) end
    espObjs = {}
    cache = {}
    for p, _ in pairs(connections) do disconnectPlayer(p) end
    connections = {}
    if ChamsContainer then pcall(function() ChamsContainer:Destroy() end); ChamsContainer = nil end
    if MeshChamsFolder then pcall(function() MeshChamsFolder:Destroy() end); MeshChamsFolder = nil end
    CleanupMeshChams(workspace)
    for _, player in ipairs(Players:GetPlayers()) do
        CleanupCharacterMeshChams(player.Character)
    end
end

function LightESP:GetConfig()
    return Config
end

function LightESP:UpdateConfig(new)
    for k, v in pairs(new) do Config[k] = v end
end

function LightESP:SetEnabled(enabled)
    Config.Enabled = enabled
end

getgenv().__LightESP_LOADED = LightESP
return LightESP
